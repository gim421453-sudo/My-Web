{
  "name": "personal-management-webapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "firebase:config": "node scripts/generate-firebase-config.mjs",
    "predev": "node scripts/generate-firebase-config.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-firebase-config.mjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/copy-static-assets.mjs dist",
    "prebuild:admin": "node scripts/generate-firebase-config.mjs",
    "build:admin": "tsc --noEmit && vite build --outDir dist-admin",
    "postbuild:admin": "node scripts/copy-static-assets.mjs dist-admin",
    "firebase:reset-test-data": "node scripts/reset-firebase-test-data.mjs",
    "firebase:delete-non-owner-accounts": "node scripts/delete-non-owner-accounts.mjs",
    "firebase:set-system-owner": "node scripts/set-system-owner.mjs",
    "firebase:init-schema": "node scripts/initialize-firebase-schema.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
