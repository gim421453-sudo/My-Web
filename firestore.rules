rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSystemOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/systemOwners/$(request.auth.uid))
        && (
          !("status" in get(/databases/$(database)/documents/systemOwners/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/systemOwners/$(request.auth.uid)).data.status == "active"
        );
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.status in ["active", "accepted"];
    }

    function workspaceRole(workspaceId) {
      return isWorkspaceMember(workspaceId)
        ? get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role
        : null;
    }

    function validWorkspaceRole(role) {
      return role in ["super_manager", "manager", "teacher", "normal", "viewer", "print_account"];
    }

    function canGrantWorkspaceRole(workspaceId, targetUid, requestedRole) {
      return signedIn()
        && targetUid != request.auth.uid
        && validWorkspaceRole(requestedRole)
        && (
          isSystemOwner()
          || (
            workspaceRole(workspaceId) == "super_manager"
            && requestedRole in ["manager", "teacher", "normal", "viewer", "print_account"]
          )
          || (
            workspaceRole(workspaceId) == "manager"
            && requestedRole in ["teacher", "normal", "viewer", "print_account"]
          )
        );
    }

    function canManageExistingMember(workspaceId, targetUid, targetRole) {
      return signedIn()
        && targetUid != request.auth.uid
        && (
          isSystemOwner()
          || (
            workspaceRole(workspaceId) == "super_manager"
            && targetRole in ["manager", "teacher", "normal", "viewer", "print_account"]
          )
          || (
            workspaceRole(workspaceId) == "manager"
            && targetRole in ["teacher", "normal", "viewer", "print_account"]
          )
        );
    }

    function optionalString(data, field, maxSize) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxSize);
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function membershipHasAllowedFields(data) {
      return data.keys().hasOnly([
        "id", "uid", "email", "displayName", "role", "status", "disabled", "active",
        "workspaceId", "workspace_id", "nestedMemberExists",
        "inviteCodeId", "inviteCode", "invitedBy", "invitedByEmail", "invitationId",
        "approvedBy", "approvalRequestId", "source",
        "joinedAt", "lastAccessAt", "createdAt", "createdBy", "updatedAt", "updatedBy",
        "roleChangedAt", "roleChangedBy", "disabledAt", "disabledBy", "enabledAt", "enabledBy"
      ]);
    }

    function membershipHasValidTypes(data, workspaceId, uid) {
      return data.uid is string
        && data.uid == uid
        && data.uid.size() > 0
        && data.workspaceId is string
        && data.workspaceId == workspaceId
        && data.workspaceId.size() > 0
        && (!("workspace_id" in data) || (data.workspace_id is string && data.workspace_id == workspaceId))
        && optionalString(data, "id", 512)
        && optionalString(data, "email", 320)
        && optionalString(data, "displayName", 512)
        && validWorkspaceRole(data.role)
        && data.status in ["active", "accepted", "disabled"]
        && optionalBool(data, "disabled")
        && optionalBool(data, "active")
        && (!("disabled" in data) || data.disabled == (data.status == "disabled"))
        && (!("active" in data) || data.active == (data.status != "disabled"))
        && optionalBool(data, "nestedMemberExists")
        && optionalString(data, "inviteCodeId", 512)
        && optionalString(data, "inviteCode", 512)
        && optionalString(data, "invitedBy", 256)
        && optionalString(data, "invitedByEmail", 320)
        && optionalString(data, "invitationId", 512)
        && optionalString(data, "approvedBy", 256)
        && optionalString(data, "approvalRequestId", 512)
        && optionalString(data, "source", 128)
        && optionalString(data, "createdBy", 256)
        && optionalString(data, "updatedBy", 256)
        && optionalString(data, "roleChangedBy", 256)
        && optionalString(data, "disabledBy", 256)
        && optionalString(data, "enabledBy", 256)
        && optionalTimestamp(data, "joinedAt")
        && optionalTimestamp(data, "lastAccessAt")
        && optionalTimestamp(data, "createdAt")
        && optionalTimestamp(data, "updatedAt")
        && optionalTimestamp(data, "roleChangedAt")
        && optionalTimestamp(data, "disabledAt")
        && optionalTimestamp(data, "enabledAt");
    }

    function validMembershipCreate(workspaceId, uid) {
      // Direct client membership creation has no server-verifiable approval proof yet.
      return false;
    }

    function validMembershipUpdate(workspaceId, uid) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let immutableKeys = [
          "id", "uid", "workspaceId", "workspace_id", "createdAt", "createdBy", "joinedAt",
          "invitationId", "approvalRequestId", "source"
        ];
      return !membershipHasAllowedFields(request.resource.data) ? false
        : affectedKeys.hasAny(immutableKeys) ? false
        : !membershipHasValidTypes(request.resource.data, workspaceId, uid) ? false
        : request.resource.data.uid != resource.data.uid ? false
        : request.resource.data.workspaceId != resource.data.workspaceId ? false
        : !(request.resource.data.updatedAt is timestamp) ? false
        : request.resource.data.updatedBy != request.auth.uid ? false
        : !canManageExistingMember(workspaceId, uid, resource.data.role) ? false
        : canGrantWorkspaceRole(workspaceId, uid, request.resource.data.role);
    }

    function inviteHasAllowedFields(data) {
      return data.keys().hasOnly([
        "invitationId", "code", "workspaceId", "role", "codeHash", "email",
        "maxUses", "usedCount", "expiresAt", "createdAt", "createdBy",
        "inviterUid", "inviterEmail", "invitedBy", "status", "usedAt", "usedBy",
        "reusable", "codePreview"
      ]);
    }

    function inviteHasValidTypes(data, workspaceId, inviteId) {
      return data.invitationId is string
        && data.invitationId == inviteId
        && data.code is string
        && data.code == inviteId
        && data.workspaceId is string
        && data.workspaceId == workspaceId
        && data.workspaceId.size() > 0
        && validWorkspaceRole(data.role)
        && data.codeHash is string
        && data.codeHash.size() > 0
        && optionalString(data, "email", 320)
        && data.maxUses is int
        && data.maxUses > 0
        && data.maxUses <= 1000
        && data.usedCount is int
        && data.usedCount >= 0
        && (data.expiresAt == null || (data.expiresAt is int && data.expiresAt > 0))
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.inviterUid is string
        && data.inviterUid == data.createdBy
        && optionalString(data, "inviterEmail", 320)
        && (!("invitedBy" in data) || (data.invitedBy is string && data.invitedBy == data.createdBy))
        && data.status in ["active", "accepted", "expired", "revoked"]
        && ((data.usedAt is string && data.usedAt == "") || data.usedAt is timestamp)
        && optionalString(data, "usedBy", 256)
        && data.reusable is bool
        && optionalString(data, "codePreview", 64);
    }

    function validInviteCreate(workspaceId, inviteId) {
      return signedIn()
        && inviteHasAllowedFields(request.resource.data)
        && inviteHasValidTypes(request.resource.data, workspaceId, inviteId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.usedCount == 0
        && request.resource.data.usedAt == ""
        && request.resource.data.usedBy == ""
        && canGrantWorkspaceRole(workspaceId, "invite_target", request.resource.data.role);
    }

    function validInviteUpdate(workspaceId, inviteId) {
      return signedIn()
        && inviteHasAllowedFields(request.resource.data)
        && inviteHasValidTypes(request.resource.data, workspaceId, inviteId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && resource.data.status == "active"
        && request.resource.data.status in ["revoked", "expired"]
        && canGrantWorkspaceRole(workspaceId, "invite_target", resource.data.role);
    }

    function isWorkspaceManager(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && workspaceRole(workspaceId) in ["super_manager", "manager"];
    }

    function isPrivilegedWorkspaceRole(workspaceId) {
      return isWorkspaceManager(workspaceId) || workspaceRole(workspaceId) == "system_owner";
    }

    function isSensitiveWorkspaceCollection(collectionId) {
      return collectionId in [
        "people",
        "friendAwards",
        "penalties",
        "exams",
        "attendance",
        "assignments",
        "lessons",
        "records",
        "portfolios",
        "academicSchedules",
        "studentAccessLogs"
      ];
    }

    function isOwnerData(data) {
      return signedIn()
        && (
          ("studentUid" in data && data.studentUid == request.auth.uid)
          || ("targetStudentId" in data && data.targetStudentId == request.auth.uid)
          || ("ownerUid" in data && data.ownerUid == request.auth.uid)
          || ("uid" in data && data.uid == request.auth.uid)
          || ("userUid" in data && data.userUid == request.auth.uid)
          || ("createdBy" in data && data.createdBy == request.auth.uid)
          || ("createdByUid" in data && data.createdByUid == request.auth.uid)
        );
    }

    function hasPublicConsent(data) {
      return ("visibility" in data)
        && data.visibility == "public"
        && (
          ("consentPublic" in data && data.consentPublic == true)
          || ("consentPublic" in data && data.consentPublic == "true")
          || ("publicApproved" in data && data.publicApproved == true)
        );
    }

    function teacherCanReadData(workspaceId, data) {
      return workspaceRole(workspaceId) == "teacher"
        && hasPublicConsent(data);
    }

    function canReadWorkspaceData(workspaceId, collectionId, data) {
      return isSystemOwner()
        || (
          isWorkspaceMember(workspaceId)
          && (
            !isSensitiveWorkspaceCollection(collectionId)
            || isWorkspaceManager(workspaceId)
            || isOwnerData(data)
            || teacherCanReadData(workspaceId, data)
          )
        );
    }

    function canWriteWorkspaceData(workspaceId, collectionId, data) {
      return isSystemOwner()
        || (
          isWorkspaceMember(workspaceId)
          && (
            isWorkspaceManager(workspaceId)
            || (
              collectionId == "studentAccessLogs"
              && ("viewerUid" in data)
              && data.viewerUid == request.auth.uid
            )
            || (
              !isSensitiveWorkspaceCollection(collectionId)
              && collectionId in [
                "settings",
                "schedules",
                "subjects",
                "teachers",
                "materials",
                "requests",
                "timetable",
                "timetableSets",
                "periodTimes",
                "meals",
                "examSchedules",
                "projects",
                "budget",
                "systemReports",
                "academic",
                "academicSchedules",
                "homeLetters",
                "schoolNotices",
                "mealApplications",
                "afterschoolPrograms",
                "afterschoolAttendance",
                "afterschoolSchedules",
                "specialLecturePrograms",
                "specialLectureAttendance",
                "specialLectureSchedules",
                "clubs",
                "clubPrograms",
                "clubAttendance",
                "clubSchedules",
                "workspaceUpdates",
                "omrForms"
              ]
            )
            || isOwnerData(data)
            || (
              workspaceRole(workspaceId) == "teacher"
              && collectionId in ["attendance", "assignments", "lessons", "exams", "records"]
            )
          )
        );
    }

    function selfUserUpdateAllowed(uid) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let allowedKeys = [
          "displayName",
          "photoURL",
          "phone",
          "locale",
          "preferences",
          "lastSeenAt",
          "updatedAt",
          "lastLoginAt"
        ];
      return !isSelf(uid) ? false
        : request.resource.data.uid != request.auth.uid ? false
        : !affectedKeys.hasOnly(allowedKeys) ? false
        : optionalString(request.resource.data, "displayName", 512)
        && optionalString(request.resource.data, "photoURL", 2048)
        && optionalString(request.resource.data, "phone", 64)
        && optionalString(request.resource.data, "locale", 32)
        && (!("preferences" in request.resource.data) || request.resource.data.preferences is map)
        && optionalTimestamp(request.resource.data, "lastSeenAt")
        && optionalTimestamp(request.resource.data, "updatedAt")
        && optionalTimestamp(request.resource.data, "lastLoginAt");
    }

    function adminUserActivationAllowed(uid) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let allowedKeys = [
          "status", "disabled", "active", "workspaceId", "currentWorkspaceId", "workspace_id",
          "pendingWorkspaceId", "pendingInviteCodeId", "approvedBy", "approvedAt", "updatedAt"
        ];
      return !signedIn() ? false
        : !affectedKeys.hasOnly(allowedKeys) ? false
        : !("status" in request.resource.data) ? false
        : request.resource.data.status != "active" ? false
        : !("workspaceId" in request.resource.data) ? false
        : !(request.resource.data.workspaceId is string) ? false
        : !("currentWorkspaceId" in request.resource.data) ? false
        : request.resource.data.currentWorkspaceId != request.resource.data.workspaceId ? false
        : !("workspace_id" in request.resource.data) ? false
        : request.resource.data.workspace_id != request.resource.data.workspaceId ? false
        : !("approvedBy" in request.resource.data) ? false
        : request.resource.data.approvedBy != request.auth.uid ? false
        : getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)/members/$(uid)).data.uid != uid ? false
        : getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)/members/$(uid)).data.status in ["active", "accepted"]
        && canGrantWorkspaceRole(
          request.resource.data.workspaceId,
          uid,
          getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)/members/$(uid)).data.role
        );
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "uid", "email", "displayName", "emailVerified", "globalRole", "role", "currentRole",
          "status", "workspaceId", "currentWorkspaceId", "workspace_id", "pendingWorkspaceId",
          "pendingInviteCodeId", "createdAt", "lastLoginAt", "updatedAt", "disabled"
        ])
        && (!("globalRole" in request.resource.data) || request.resource.data.globalRole == "user")
        && (!("role" in request.resource.data) || request.resource.data.role == "normal")
        && (!("currentRole" in request.resource.data) || request.resource.data.currentRole == "normal")
        && request.resource.data.status in ["pending", "waiting_approval"]
        && request.resource.data.workspaceId == null
        && request.resource.data.currentWorkspaceId == null
        && request.resource.data.workspace_id == null
        && request.resource.data.disabled == false;
      allow read: if isSelf(uid)
        || isSystemOwner()
        || (
          resource.data.currentWorkspaceId is string
          && isWorkspaceManager(resource.data.currentWorkspaceId)
        )
        || (
          resource.data.workspaceId is string
          && isWorkspaceManager(resource.data.workspaceId)
        );
      allow update: if isSystemOwner() || selfUserUpdateAllowed(uid) || adminUserActivationAllowed(uid);
      allow delete: if isSystemOwner();
    }

    match /workspaces/{workspaceId} {
      allow create: if isSystemOwner()
        || (
          signedIn()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.ownerUid == request.auth.uid
        );
      allow read: if isSystemOwner() || isWorkspaceMember(workspaceId);
      allow update, delete: if isSystemOwner() || isWorkspaceManager(workspaceId);

      match /members/{uid} {
        allow create: if validMembershipCreate(workspaceId, uid);
        allow update: if resource == null ? false : validMembershipUpdate(workspaceId, uid);
        allow read: if signedIn() && (isSystemOwner() || request.auth.uid == uid || isWorkspaceMember(workspaceId));
        allow delete: if false;
      }

      match /inviteCodes/{inviteCodeId} {
        allow get: if signedIn()
          && resource.data.status == "active";
        allow list: if isSystemOwner() || isWorkspaceManager(workspaceId);
        allow create: if validInviteCreate(workspaceId, inviteCodeId);
        allow update: if validInviteUpdate(workspaceId, inviteCodeId);
        allow delete: if isSystemOwner() || isWorkspaceManager(workspaceId);

        match /usedUsers/{uid} {
          allow create, update: if false;
          allow read: if isSystemOwner() || isWorkspaceManager(workspaceId) || request.auth.uid == uid;
          allow delete: if isSystemOwner() || isWorkspaceManager(workspaceId);
        }
      }

      match /notices/{noticeId} {
        allow read: if isSystemOwner() || isWorkspaceMember(workspaceId);
        allow create: if request.resource.data.workspaceId == workspaceId
          && (
            isSystemOwner()
            || (
            isWorkspaceMember(workspaceId)
            && (
              !("authorUid" in request.resource.data)
              || request.resource.data.authorUid == request.auth.uid
            )
            && workspaceRole(workspaceId) in ["super_manager", "manager", "teacher", "normal"]
            )
          );
        allow update, delete: if isSystemOwner()
          || isWorkspaceManager(workspaceId)
          || (
            isWorkspaceMember(workspaceId)
            && resource.data.authorUid == request.auth.uid
          );
      }

      match /{collectionId}/{docId} {
        allow read: if !(collectionId in ["members", "inviteCodes", "notices"])
          && canReadWorkspaceData(workspaceId, collectionId, resource.data);
        allow create, update: if !(collectionId in ["members", "inviteCodes", "notices"])
          && canWriteWorkspaceData(workspaceId, collectionId, request.resource.data);
        allow delete: if !(collectionId in ["members", "inviteCodes", "notices"])
          && (isSystemOwner() || isWorkspaceManager(workspaceId));
      }
    }

    match /workspace_members/{memberId} {
      allow read: if signedIn()
        && (
          isSystemOwner()
          || resource.data.uid == request.auth.uid
          || isWorkspaceManager(resource.data.workspaceId)
        );
      allow create, update, delete: if false;
    }

    match /workspaceMembers/{memberId} {
      allow read: if signedIn()
        && (
          isSystemOwner()
          || resource.data.uid == request.auth.uid
          || isWorkspaceManager(resource.data.workspaceId)
        );
      allow create, update, delete: if false;
    }

    match /user_devices/{deviceId} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.workspaceId is string
        && isWorkspaceMember(request.resource.data.workspaceId);
      allow read, delete: if signedIn()
        && (
          isSystemOwner()
          || resource.data.uid == request.auth.uid
          || isWorkspaceManager(resource.data.workspaceId)
        );
    }

    match /notifications/{notificationId} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.workspaceId is string
        && isWorkspaceMember(request.resource.data.workspaceId);
      allow read, delete: if signedIn()
        && (
          isSystemOwner()
          || resource.data.uid == request.auth.uid
          || isWorkspaceManager(resource.data.workspaceId)
        );
    }

    match /invitations/{invitationId} {
      allow read: if signedIn()
        && resource.data.workspaceId is string
        && (isSystemOwner() || isWorkspaceManager(resource.data.workspaceId));
      allow create: if validInviteCreate(request.resource.data.workspaceId, invitationId);
      allow update: if validInviteUpdate(resource.data.workspaceId, invitationId);
      allow delete: if isSystemOwner() || isWorkspaceManager(resource.data.workspaceId);
    }

    match /invites/{inviteCode} {
      allow get: if signedIn()
        && resource.data.status == "active";
      allow list: if false;
      allow create: if validInviteCreate(request.resource.data.workspaceId, inviteCode);
      allow update: if validInviteUpdate(resource.data.workspaceId, inviteCode);
      allow delete: if isSystemOwner() || isWorkspaceManager(resource.data.workspaceId);

      match /usedUsers/{uid} {
        allow create, update: if false;
        allow read: if signedIn() && (isSystemOwner() || request.auth.uid == uid);
        allow delete: if false;
      }
    }

    match /users/{inviteOwnerUid}/invitedUsers/{joinedUserUid} {
      allow create, update: if signedIn()
        && request.auth.uid == joinedUserUid
        && request.resource.data.uid == joinedUserUid;
      allow read, delete: if signedIn()
        && (isSystemOwner() || request.auth.uid == inviteOwnerUid);
    }

    match /workspaceJoinRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.workspaceId is string;
      allow read: if isSystemOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isSystemOwner()
        || (
          signedIn()
          && resource.data.status == "pending"
          && request.resource.data.status == "approved"
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "approvedBy", "approvedAt", "updatedAt"
          ])
          && getAfter(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)/members/$(resource.data.uid)).data.uid == resource.data.uid
          && getAfter(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)/members/$(resource.data.uid)).data.status in ["active", "accepted"]
          && canGrantWorkspaceRole(
            resource.data.workspaceId,
            resource.data.uid,
            getAfter(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)/members/$(resource.data.uid)).data.role
          )
        );
      allow delete: if isSystemOwner();
    }

    match /adminApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";
      allow read: if isSystemOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isSystemOwner();
    }

    match /systemConfig/{docId} {
      allow read: if docId == "bootstrap";
      allow create, update, delete: if isSystemOwner();
    }

    match /systemConfigs/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isSystemOwner();

      match /versions/{versionId} {
        allow read: if signedIn();
        allow create, update, delete: if isSystemOwner();
      }
    }

    match /systemNotices/{noticeId} {
      allow read: if signedIn();
      allow create, update, delete: if isSystemOwner();
    }

    match /systemIntegrations/{integrationId} {
      allow read, create, update, delete: if isSystemOwner();
    }

    match /systemIntegrationLogs/{logId} {
      allow read, create: if isSystemOwner();
      allow update, delete: if false;
    }

    match /adminLogs/{logId} {
      allow read, create: if isSystemOwner();
      allow update, delete: if false;
    }

    match /logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.workspaceId is string
        && (
          isSystemOwner()
          || isWorkspaceMember(request.resource.data.workspaceId)
        );
      allow read: if isSystemOwner()
        || (
          signedIn()
          && resource.data.workspaceId is string
          && (
            resource.data.uid == request.auth.uid
            || isWorkspaceManager(resource.data.workspaceId)
          )
        );
      allow update, delete: if false;
    }

    match /chatThreads/{threadId} {
      function canReadChatThread(thread) {
        return isSystemOwner()
          || (
            signedIn()
            && thread.workspaceId is string
            && (
              isWorkspaceManager(thread.workspaceId)
              || request.auth.uid in thread.participantUids
              || thread.createdByUid == request.auth.uid
              || (
                workspaceRole(thread.workspaceId) == "teacher"
                && thread.relatedTeacherUid == request.auth.uid
              )
            )
          );
      }

      function validChatThreadCreate() {
        return request.resource.data.workspaceId is string
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByRole is string
          && request.resource.data.source in ["main", "recording"]
          && request.resource.data.status in ["new", "processing", "answered", "closed", "hold"]
          && request.resource.data.participantUids is list
          && request.auth.uid in request.resource.data.participantUids
          && request.resource.data.title is string;
      }

      allow read: if canReadChatThread(resource.data);
      allow create: if signedIn()
        && validChatThreadCreate()
        && (
          isSystemOwner()
          || (
            isWorkspaceMember(request.resource.data.workspaceId)
            && (
              request.resource.data.type == "support"
              || isWorkspaceManager(request.resource.data.workspaceId)
            )
          )
        );
      allow update: if signedIn()
        && request.resource.data.workspaceId == resource.data.workspaceId
        && (
          isSystemOwner()
          || isWorkspaceManager(resource.data.workspaceId)
          || (
            canReadChatThread(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "lastMessage",
              "lastMessageText",
              "lastMessageAuthorUid",
              "lastMessageAt",
              "updatedAt",
              "participantUids",
              "participantRoles",
              "relatedLogId",
              "relatedLogIds",
              "readBy",
              "unreadByUid"
            ])
          )
        );
      allow delete: if isSystemOwner();
    }

    match /chatMessages/{messageId} {
      function parentThread() {
        return get(/databases/$(database)/documents/chatThreads/$(request.resource.data.threadId)).data;
      }

      function existingParentThread() {
        return get(/databases/$(database)/documents/chatThreads/$(resource.data.threadId)).data;
      }

      function canReadMessageThread(thread) {
        return isSystemOwner()
          || (
            signedIn()
            && thread.workspaceId is string
            && (
              isWorkspaceManager(thread.workspaceId)
              || request.auth.uid in thread.participantUids
              || thread.createdByUid == request.auth.uid
              || (
                workspaceRole(thread.workspaceId) == "teacher"
                && thread.relatedTeacherUid == request.auth.uid
              )
            )
          );
      }

      allow read: if canReadMessageThread(existingParentThread());
      allow create: if signedIn()
        && request.resource.data.threadId is string
        && request.resource.data.workspaceId == parentThread().workspaceId
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole is string
        && request.resource.data.senderName is string
        && request.resource.data.message is string
        && request.resource.data.source in ["main", "recording"]
        && canReadMessageThread(parentThread());
      allow update, delete: if false;
    }

    match /recordingJobs/{jobId} {
      allow read: if isSystemOwner()
        || (
          signedIn()
          && resource.data.workspaceId is string
          && (
            resource.data.uid == request.auth.uid
            || isWorkspaceManager(resource.data.workspaceId)
          )
        );
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.workspaceId is string
        && isWorkspaceMember(request.resource.data.workspaceId);
      allow delete: if isSystemOwner()
        || (
          signedIn()
          && resource.data.workspaceId is string
          && isWorkspaceManager(resource.data.workspaceId)
        );
    }

    match /driveConnections/{connectionId} {
      allow read: if isSystemOwner()
        || (
          signedIn()
          && resource.data.workspaceId is string
          && (
            resource.data.uid == request.auth.uid
            || isWorkspaceManager(resource.data.workspaceId)
          )
        );
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.workspaceId is string
        && isWorkspaceMember(request.resource.data.workspaceId);
      allow delete: if isSystemOwner()
        || (
          signedIn()
          && resource.data.workspaceId is string
          && (
            resource.data.uid == request.auth.uid
            || isWorkspaceManager(resource.data.workspaceId)
          )
        );
    }

    match /systemEventLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.workspaceId is string
        && (
          isSystemOwner()
          || isWorkspaceMember(request.resource.data.workspaceId)
        );
      allow read: if isSystemOwner()
        || (
          signedIn()
          && resource.data.workspaceId is string
          && (
            resource.data.uid == request.auth.uid
            || isWorkspaceManager(resource.data.workspaceId)
          )
        );
      allow update, delete: if false;
    }

    match /supportThreads/{threadId} {
      function threadWorkspaceId() {
        return resource.data.workspaceId;
      }

      function requestThreadWorkspaceId() {
        return request.resource.data.workspaceId;
      }

      function isThreadParticipant() {
        return signedIn()
          && request.auth.uid in resource.data.participantUids;
      }

      function isRequestThreadParticipant() {
        return signedIn()
          && request.auth.uid in request.resource.data.participantUids;
      }

      function canReadThread() {
        return isSystemOwner()
          || (
            signedIn()
            && threadWorkspaceId() is string
            && (
              isWorkspaceManager(threadWorkspaceId())
              || isThreadParticipant()
            )
          );
      }

      function validThreadPayload() {
        return request.resource.data.workspaceId is string
          && request.resource.data.type in ["admin", "support"]
          && request.resource.data.status in ["new", "in_progress", "completed"]
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByRole is string
          && request.resource.data.participantUids is list
          && request.resource.data.participantRoles is list
          && request.resource.data.title is string;
      }

      allow read: if canReadThread();
      allow create: if signedIn()
        && validThreadPayload()
        && (
          isSystemOwner()
          || (
            isWorkspaceMember(requestThreadWorkspaceId())
            && isRequestThreadParticipant()
            && (
              request.resource.data.type == "support"
              || isWorkspaceManager(requestThreadWorkspaceId())
            )
          )
        );
      allow update: if signedIn()
        && request.resource.data.workspaceId == resource.data.workspaceId
        && (
          isSystemOwner()
          || isWorkspaceManager(resource.data.workspaceId)
          || (
            isThreadParticipant()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "lastMessageText",
              "lastMessageAuthorUid",
              "lastMessageAt",
              "updatedAt",
              "participantUids",
              "participantRoles",
              "relatedLogIds",
              "readBy",
              "unreadByUid"
            ])
          )
        );
      allow delete: if isSystemOwner();

      match /messages/{messageId} {
        function parentThread() {
          return get(/databases/$(database)/documents/supportThreads/$(threadId)).data;
        }

        function canReadParentThread() {
          return isSystemOwner()
            || (
              signedIn()
              && parentThread().workspaceId is string
              && (
                isWorkspaceManager(parentThread().workspaceId)
                || request.auth.uid in parentThread().participantUids
              )
            );
        }

        allow read: if canReadParentThread();
        allow create: if signedIn()
          && canReadParentThread()
          && request.resource.data.threadId == threadId
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole is string
          && request.resource.data.workspaceId == parentThread().workspaceId
          && request.resource.data.createdAt is timestamp
          && (
            !("logId" in request.resource.data)
            || request.resource.data.logId == null
            || request.resource.data.logId is string
          );
        allow update, delete: if false;
      }
    }

    match /systemOwners/{uid} {
      allow read: if isSystemOwner() || isSelf(uid);
      allow create, update, delete: if isSystemOwner();
    }

    match /{path=**}/members/{uid} {
      allow read: if isSystemOwner()
        || (
          signedIn()
          && resource.data.workspaceId is string
          && isWorkspaceMember(resource.data.workspaceId)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
